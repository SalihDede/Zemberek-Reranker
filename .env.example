# ── LLM (OpenRouter veya uyumlu herhangi bir OpenAI-API endpoint) ──────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-3-27b-it
LLM_API_KEY=sk-or-your-key-here

# ── Zemberek Java Gateway (benchmark.sh otomatik başlatır) ──────────────────
ZEMBEREK_HOST=localhost
ZEMBEREK_PORT=25333

# ── Google Morphology Gateway (--backend google/hybrid için gerekli) ────────
# start_google_gateway.sh ile başlatılır (Docker gerekli)
GOOGLE_MORPH_HOST=localhost
GOOGLE_MORPH_PORT=8765
